<% layout("/layouts/boilerplate") %>
<div class="container">
    <h1>Project Tracking System</h1>
        <h3>All Users</h3>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
          <% for(let user of allUsers){ %>
            <div class="col-md-4 mb-3">
              <div class="card h-100">
                <div class="card-body">
                  <div class="user-info">
                    <div class="card-img">
                      <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                    <h5 class="card-title"><%= user.name %></h5>
                    <p class="card-text">Email: <%= user.email %></p>g
                  </div>
                </div>
                <hr>
     <a href="/users/<%= user._id %>" class="card-link">View Details</a>
    <a href="/users/<%= user._id %>/projects" class="card-link">Add Project</a>
              </div>
            </div>
            </div>
          <% } %>
        </div>
</div>

    
