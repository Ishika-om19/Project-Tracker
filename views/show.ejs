<% layout("/layouts/boilerplate") %>
<div class="show-page">
<div class="container">
     <div class="card-show shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
    <div>
    <h1 class="project-heading"><%= user.name %>'s Projects</h1>
    <p  class="text-muted ">Manage and track all your projects </p>
    <span class="badge bg-primary fs-6">Total Projects: <%= projects.length %></span>
    </div>
    <a href="/users/<%= user._id %>/projects/new" class="btn btn-primary ">+ New Project</a>
</div>
</div>

    <% if(projects.length > 0){ %>
    <% for(let project of projects) { %>
        <div class="card project-card shadow-sm mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="card-title"><%= project.title %></h4>
                    
                     <% if(project.status === "Completed") { %>
            <span class="badge bg-success">Completed</span>
            <% } else if (project.status === "In Progress") { %>
                <span class="badge bg-primary">In Progress</span>
                <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                    <% } %>
                </div>
                <p class="card-text text-muted"><%= project.description %></p>
                <hr>
           <div class="row mt-1">
            <div class="col-md-6">
          <strong>Start Date :</strong>
          <%= project.startDate.toLocaleDateString() %>
          </div>
           <div class="col-md-6">
         <strong>End Date :</strong>
         <%= project.endDate.toLocaleDateString() %>
       </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a href="/projects/<%= project._id %>/edit"  class="btn btn-outline-primary btn-sm "> Edit </a>
        <form action="/projects/<%= project._id %>?_method=DELETE" method="POST">
            <button class="btn btn-outline-danger btn-sm">Delete</button>
        </form>
        </div>
    </div>
  </div>  
           <% } %>
        
        <% } else { %>
            <div class="alert alert-danger">
                No projects found. Create your first project!
            </div>

         <% } %>

         <form action="/users/<%= user._id %>/projects/new" method="GET">
             <button type="submit" class="btn btn-primary create-btn">Create Project</button>
         </form>

         </div>
     </div>